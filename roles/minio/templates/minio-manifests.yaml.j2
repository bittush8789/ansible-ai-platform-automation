apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: minio-pvc
  namespace: {{ k8s_mlops_namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: local-path
  resources:
    requests:
      storage: {{ minio_storage_size }}
---
apiVersion: v1
kind: Secret
metadata:
  name: minio-secret
  namespace: {{ k8s_mlops_namespace }}
type: Opaque
stringData:
  MINIO_ROOT_USER: "{{ vault_minio_root_user }}"
  MINIO_ROOT_PASSWORD: "{{ vault_minio_root_password }}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: minio
  namespace: {{ k8s_mlops_namespace }}
  labels:
    app: minio
spec:
  replicas: 1
  selector:
    matchLabels:
      app: minio
  template:
    metadata:
      labels:
        app: minio
    spec:
      containers:
        - name: minio
          image: minio/minio:RELEASE.2023-09-04T19-57-37Z
          args:
            - server
            - /data
            - --console-address
            - :9001
          ports:
            - containerPort: 9000
              name: minio-api
            - containerPort: 9001
              name: minio-console
          env:
            - name: MINIO_ROOT_USER
              valueFrom:
                secretKeyRef:
                  name: minio-secret
                  key: MINIO_ROOT_USER
            - name: MINIO_ROOT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: minio-secret
                  key: MINIO_ROOT_PASSWORD
          volumeMounts:
            - name: minio-storage
              mountPath: /data
      volumes:
        - name: minio-storage
          persistentVolumeClaim:
            claimName: minio-pvc
---
apiVersion: v1
kind: Service
metadata:
  name: {{ minio_service_name }}
  namespace: {{ k8s_mlops_namespace }}
spec:
  ports:
    - name: api
      port: {{ minio_api_port }}
      targetPort: 9000
    - name: console
      port: {{ minio_console_port }}
      targetPort: 9001
  selector:
    app: minio
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: minio-ingress
  namespace: {{ k8s_mlops_namespace }}
  annotations:
    nginx.ingress.kubernetes.io/proxy-body-size: "1024m"
spec:
  ingressClassName: nginx
  rules:
    - host: {{ ingress_domain_minio }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ minio_service_name }}
                port:
                  number: {{ minio_console_port }}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: minio-bucket-init
  namespace: {{ k8s_mlops_namespace }}
spec:
  template:
    metadata:
      labels:
        app: minio-bucket-init
    spec:
      restartPolicy: OnFailure
      containers:
        - name: mc-init
          image: minio/mc:RELEASE.2023-09-04T16-39-52Z
          command:
            - /bin/sh
            - -c
            - |
              echo "Waiting for MinIO api at http://{{ minio_service_name }}:{{ minio_api_port }}..."
              until curl -sf http://{{ minio_service_name }}:{{ minio_api_port }}/minio/health/live; do
                sleep 2
              done
              echo "MinIO is active. Configuring bucket..."
              mc alias set myminio http://{{ minio_service_name }}:{{ minio_api_port }} {{ vault_minio_root_user }} {{ vault_minio_root_password }}
              mc mb myminio/{{ minio_mlflow_bucket }} --ignore-existing
              echo "Bucket {{ minio_mlflow_bucket }} created successfully."
