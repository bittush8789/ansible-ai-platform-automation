# Grafana Helm values overrides

adminUser: "{{ vault_grafana_admin_user }}"
adminPassword: "{{ vault_grafana_admin_password }}"

datasources:
  datasources.yaml:
    apiVersion: 1
    datasources:
      - name: Prometheus
        type: prometheus
        access: proxy
        url: http://prometheus-server.monitoring.svc.cluster.local
        isDefault: true

sidecar:
  dashboards:
    enabled: true
    label: grafana_dashboard
    labelValue: "1"
    searchNamespace: ALL

ingress:
  enabled: true
  ingressClassName: nginx
  hosts:
    - {{ ingress_domain_grafana }}
  path: /
