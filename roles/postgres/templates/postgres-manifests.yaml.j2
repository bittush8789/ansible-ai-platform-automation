apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: postgres-pvc
  namespace: {{ k8s_mlops_namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: local-path
  resources:
    requests:
      storage: {{ postgres_storage_size }}
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: {{ k8s_mlops_namespace }}
type: Opaque
stringData:
  POSTGRES_USER: "{{ vault_postgres_user }}"
  POSTGRES_PASSWORD: "{{ vault_postgres_password }}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgres
  namespace: {{ k8s_mlops_namespace }}
  labels:
    app: postgres
spec:
  replicas: 1
  selector:
    matchLabels:
      app: postgres
  template:
    metadata:
      labels:
        app: postgres
    spec:
      containers:
        - name: postgres
          image: postgres:15-alpine
          ports:
            - containerPort: 5432
              name: postgres
          env:
            - name: POSTGRES_DB
              value: "{{ postgres_db_name }}"
            - name: POSTGRES_USER
              valueFrom:
                secretKeyRef:
                  name: postgres-secret
                  key: POSTGRES_USER
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres-secret
                  key: POSTGRES_PASSWORD
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
          volumeMounts:
            - name: postgres-storage
              mountPath: /var/lib/postgresql/data
      volumes:
        - name: postgres-storage
          persistentVolumeClaim:
            claimName: postgres-pvc
---
apiVersion: v1
kind: Service
metadata:
  name: {{ postgres_service_name }}
  namespace: {{ k8s_mlops_namespace }}
spec:
  ports:
    - port: {{ postgres_port }}
      targetPort: 5432
  selector:
    app: postgres
